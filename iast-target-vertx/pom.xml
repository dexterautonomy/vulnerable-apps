<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hingebridge.iasttarget</groupId>
    <artifactId>iast-target-vertx</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>IAST target - Vert.x Web</name>

    <!--
        A TARGET for the IAST agent, not a DAST target. The vulnerable-app-* projects beside this one
        exist to be scanned from the outside; this one exists to be watched from the INSIDE, and its
        job is to make the agent's Vert.x request boundary and its context carriage do real work.

        Deliberately small. What is under test is the agent, so every endpoint here is the shortest
        path from a request value to a dangerous call that still crosses the threads a real Vert.x
        application crosses.
    -->
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <vertx.version>4.5.10</vertx.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
            <version>${vertx.version}</version>
        </dependency>
        <!--
            Jackson, because it is the ONLY request-body source the shipped catalog has that a Vert.x
            application can reach. See this project's README: the catalog has no Vert.x source at all,
            so a query parameter never becomes tainted here and a JSON body does.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-libs</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
